     "INDEFINITELY",
     "$1,000",
     "3 years",
     "FAA Form 8000-4 (1-67)",
     "SUPERCEDES FAA FORM 395",
     "empowered to operate an approved REPAIR STATION",
     "This Certificate is not Transferable"
    ]
   },
