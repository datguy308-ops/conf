# Confidence Aviation – Apache / Plesk configuration (copied to public/.htaccess by tools/build.py)

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset utf-8
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- Canonical host (www + https) --------------------------------------------------
  # Left disabled on purpose: enable only after confirming the hosting panel is not
  # already doing this (a duplicate rule behind the Plesk nginx proxy can loop).
  # RewriteCond %{HTTPS} !=on [OR]
  # RewriteCond %{HTTP_HOST} !^www\. [NC]
  # RewriteRule ^ https://www.confidenceaviation.com%{REQUEST_URI} [L,R=301]

  # --- Old URL: /index.htm was an exact duplicate of the home page -------------------
  # THE_REQUEST checks what the browser asked for, so the DirectoryIndex lookup of "/"
  # can never trigger this rule (no redirect loop).
  RewriteCond %{THE_REQUEST} \s/+index\.html?[?\s] [NC]
  RewriteRule ^index\.html?$ / [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+es/index\.html?[?\s] [NC]
  RewriteRule ^es/index\.html?$ /es/ [R=301,L]
</IfModule>

# Every other original URL (about.htm, capabilities.htm, certificates.htm, shop.htm,
# contact.htm and every original image file) is served unchanged – no redirect needed.

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  # No third-party scripts, styles, fonts or frames are used. The one inline script (sets
  # class="js" on <html>) is allowed by its hash; tools/build.py must keep it byte-identical.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-cvlem2Rlcb+inScVb7910PMAU98gRDEfAIUVUKXOWd4='; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; form-action mailto:; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
  # Enable only after HTTPS is confirmed on both www and non-www hosts:
  # Header always set Strict-Transport-Security "max-age=31536000"
  <FilesMatch "\.(html?)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # CSS/JS are referenced with a content hash (?v=...), so they can be cached for a year.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(jpe?g|png|gif|webp|ico|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/xml text/xml text/plain image/svg+xml application/ld+json
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType application/xml .xml
</IfModule>
